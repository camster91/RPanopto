<Window x:Class="PanoptoScheduler.App.CredentialsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panopto Scheduler — setup" Height="480" Width="580"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13">

    <!-- No Window.Resources. These styles were the same three declarations the
         other windows carried, and the button was the fourth copy of a template
         that had no hover or pressed state; they all live in App.xaml now. The
         named styles are applied explicitly because App.xaml deliberately has no
         implicit styles — an implicit TextBox style there would also restyle the
         boxes inside the bulk window's DataGrids. -->

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Connect to Panopto" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Secondary}" Margin="0,6,0,0"
                       Text="Enter the OAuth client your Panopto administrator created for you. This is saved to your own user profile and is used only by this app." />
        </StackPanel>

        <!-- The labels sit beside the inputs rather than being wired to them, so a
             screen reader reached three controls with no name at all. The
             AutomationProperties carry the label's words to the accessibility
             tree; the HelpText carries the explanation, which a reader would
             otherwise only reach by arrowing past the field. -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Panopto site" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TenantBox"
                     Style="{StaticResource FieldTextBox}"
                     AutomationProperties.Name="Panopto site"
                     AutomationProperties.HelpText="For example rotman.ca.panopto.com"
                     TabIndex="0" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Client ID" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ClientIdBox"
                     Style="{StaticResource FieldTextBox}"
                     AutomationProperties.Name="Client ID"
                     AutomationProperties.HelpText="The OAuth client your Panopto administrator created for you"
                     TabIndex="1" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Client secret" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="ClientSecretBox"
                         Style="{StaticResource FieldPasswordBox}"
                         AutomationProperties.Name="Client secret"
                         AutomationProperties.HelpText="Stored in plain text in your profile folder, as Panopto does not support clients without a secret"
                         TabIndex="2" />
            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,0"
                       Text="Stored in plain text in your profile folder, as Panopto does not support clients without a secret. It grants no access on its own — you still sign in as yourself." />
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="ErrorText" Foreground="{StaticResource Danger}"
                   TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,6,0,0" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource DialogButton}"
                    IsCancel="True" Margin="0,0,10,0" TabIndex="3" />
            <Button Content="Save" Style="{StaticResource DialogButton}"
                    IsDefault="True" Click="OnSaveClick" TabIndex="4" />
        </StackPanel>
    </Grid>
</Window>
