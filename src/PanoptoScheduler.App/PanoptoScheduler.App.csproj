<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PanoptoScheduler.Core\PanoptoScheduler.Core.csproj" />
  </ItemGroup>

  <!--
    The icon is generated by src\make-icon.ps1 rather than hand-drawn, and the
    .ico is committed so a build needs nothing but the SDK. Two build items:
    ApplicationIcon puts it on the executable itself, which is what Explorer,
    the taskbar and the shortcut the installer creates all read; the Resource
    below is what the windows bind to for their title bars.
  -->
  <PropertyGroup>
    <ApplicationIcon>Assets\PanoptoScheduler.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\PanoptoScheduler.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!--
      Declares per-monitor DPI awareness, so the app is sharp above 100% scaling
      and re-renders when dragged between monitors at different scales rather
      than being stretched as a bitmap. The file carries no
      requestedExecutionLevel, so the default asInvoker stands and nothing here
      can make the app prompt for elevation. See the comments in app.manifest.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    Stamped rather than left to default. Without these the title bar reads
    "1.0.0" forever and a support call cannot tell which build someone is on,
    which is the difference between knowing where to look and guessing.
    Bump Version for a release; the version is what the title bar and the log
    both show.
  -->
  <PropertyGroup>
    <Version>1.3.0</Version>
    <AssemblyVersion>1.3.0.0</AssemblyVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Product>Panopto Scheduler</Product>
    <Company>Rotman School of Management</Company>
    <Description>Schedules and edits Panopto recordings for the AV team.</Description>
    <!--
      AssemblyTitle is not decoration: without it the file's FileDescription
      falls back to the assembly name, so Task Manager's Name column and the
      taskbar tooltip both read "PanoptoScheduler.App". This is the string
      someone deciding whether to trust an unsigned download actually sees.
    -->
    <AssemblyTitle>Panopto Scheduler</AssemblyTitle>
    <Copyright>Copyright (c) Rotman School of Management</Copyright>
  </PropertyGroup>

</Project>
