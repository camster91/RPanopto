<Window x:Class="PanoptoScheduler.App.BulkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk actions — Panopto Scheduler" Height="720" Width="1080"
        MinHeight="420" MinWidth="760"
        Icon="pack://application:,,,/Assets/PanoptoScheduler.ico"
        Background="{StaticResource WindowBg}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- The checkboxes in these rows line up with the text boxes beside them,
             and no shared style knows that, so this one stays per-window. -->
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- Status bar, so both tabs report in one place. -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,12,0,0">
            <DockPanel>
                <!-- The title bar's X was the only way out of this window. -->
                <Button DockPanel.Dock="Right" Content="Close"
                        Style="{StaticResource ActionButton}"
                        Click="Close_Click"
                        Margin="12,0,0,0" MinWidth="80"
                        ToolTip="Close this window (Escape)" />

                <StackPanel>
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                    <!-- The tooltip carries the whole exception chain; the line
                         carries the one sentence a person can act on. -->
                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Secondary}" FontSize="12"
                               TextWrapping="Wrap" ToolTip="{Binding DetailTooltip}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Background="Transparent" BorderThickness="0"
                    SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">

            <!-- ============ Book recordings ============ -->
            <TabItem Header="Book recordings" DataContext="{Binding Booking}">
                <DockPanel Margin="4,10,4,0">

                    <!-- The pattern is a form that fills the grid, not a second way
                         to book, so it folds away once the rows are in. -->
                    <Expander DockPanel.Dock="Top" IsExpanded="True" Margin="0,0,0,10"
                              Header="Pattern — describe a repeat and add its rows to the grid">
                        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="4,8,0,0">
                            <Grid DataContext="{Binding Pattern}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Column 0: when. -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Dates" Style="{StaticResource FieldLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Style="{StaticResource FieldTextBox}" Width="120"
                                                 Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Width="120"
                                                 Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <TextBlock Text="Days" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                    <ItemsControl ItemsSource="{Binding Weekdays}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Label}"
                                                          IsChecked="{Binding IsTicked, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Times" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Style="{StaticResource FieldTextBox}" Width="120"
                                                 Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0" />
                                        <TextBox Style="{StaticResource FieldTextBox}" Width="120"
                                                 Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>

                                    <CheckBox Content="Allow an end before the start to run overnight"
                                              IsChecked="{Binding AllowOvernight}" Margin="0,10,0,0" />

                                    <TextBlock Text="Skip dates" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Width="280"
                                             Text="{Binding SkipDatesText, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <!-- Column 1: what it is called, and where it goes. -->
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="Recording name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Width="260"
                                             Text="{Binding TitleFormat, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="{StaticResource Muted}" FontSize="11"
                                               TextWrapping="Wrap" Width="260" Margin="0,4,0,0"
                                               Text="{}{room} · {date} · {dow} · {n} · {nn} padded · {total}" />

                                    <TextBlock Text="Presenter" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Width="260"
                                             Text="{Binding Presenter, UpdateSourceTrigger=PropertyChanged}" />

                                    <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" Margin="0,10,0,0" />
                                    <TextBox Style="{StaticResource FieldTextBox}" Width="260"
                                             Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />

                                    <CheckBox Content="Webcast these recordings"
                                              IsChecked="{Binding IsBroadcast}" Margin="0,10,0,0" />
                                </StackPanel>

                                <!-- Column 2: which rooms. The count is the whole point of
                                     this panel: it is the visible proof that the room list
                                     was read to the end rather than its first page. -->
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Secondary}" FontSize="12"
                                                   Text="{Binding TickedRoomsSummary}" />
                                        <TextBlock Text="Rooms" Style="{StaticResource FieldLabel}" />
                                    </DockPanel>

                                    <TextBox Style="{StaticResource FieldTextBox}"
                                             Text="{Binding RoomFilter, UpdateSourceTrigger=PropertyChanged}" />

                                    <ListBox ItemsSource="{Binding Shown}" Height="148" Margin="0,6,0,0"
                                             Background="{StaticResource Surface}"
                                             BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <!-- No selection highlight: ticking is the interaction
                                                 here, and a second highlight on top of it would
                                                 read as a second, different kind of tick. -->
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="2,1" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Tick shown" Style="{StaticResource ActionButton}"
                                                Command="{Binding TickShownCommand}" />
                                        <Button Content="Untick shown" Style="{StaticResource ActionButton}"
                                                Command="{Binding UntickShownCommand}" />
                                        <Button Content="Clear" Style="{StaticResource ActionButton}"
                                                Command="{Binding ClearRoomsCommand}" />
                                        <Button Content="Reload rooms" Style="{StaticResource ActionButton}"
                                                Command="{Binding ReloadRoomsCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Re-reads the tenant's room list" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding RoomSummary}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Secondary}" FontSize="12"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- Row 1: the patterns worth keeping for next term.
                                     A strip rather than a box of its own, because it acts on
                                     the form above it instead of being a thing to look at;
                                     and it is the one input method here that outlives the
                                     session, so it belongs beside the form it captures. -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <TextBlock Text="Saved templates" Style="{StaticResource FieldLabel}" />

                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                    Margin="12,0,0,0">
                                            <!-- A template keeps the rooms, the weekdays, the hour
                                                 and the naming — the things that are the same next
                                                 term. It deliberately keeps no dates, so loading
                                                 one leaves the dates already in the form alone:
                                                 those are the one part that is always stale. -->
                                            <Button Content="Load into the form"
                                                    Style="{StaticResource ActionButton}"
                                                    Command="{Binding LoadIntoFormCommand}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="Fills the form above. Leaves the dates alone." />
                                            <Button Content="Save as a template"
                                                    Style="{StaticResource ActionButton}"
                                                    Command="{Binding SaveTemplateCommand}"
                                                    ToolTip="Keeps this pattern for next term" />
                                            <Button Content="Delete"
                                                    Style="{StaticResource ActionButton}"
                                                    Command="{Binding DeleteTemplateCommand}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    ToolTip="Removes the picked template from the file" />
                                        </StackPanel>

                                        <!-- No selection highlight: picking is the interaction
                                             here, exactly as ticking is in the room list. -->
                                        <ComboBox x:Name="TemplatePicker"
                                                  MinWidth="200" MaxWidth="320" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding Templates}"
                                                  SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}"
                                                  DisplayMemberPath="Name" />
                                    </DockPanel>

                                    <TextBlock Text="{Binding TemplateNote}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Secondary}" FontSize="12"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- Row 2: the problems, and the buttons. -->
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <Border Background="{StaticResource DangerSoft}"
                                            BorderBrush="{StaticResource DangerSoftBorder}"
                                            BorderThickness="1" CornerRadius="5" Padding="10,8"
                                            Margin="0,0,0,10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ItemsControl ItemsSource="{Binding Problems}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}"
                                                               Foreground="{StaticResource DangerText}"
                                                               FontSize="12" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="_Add rows to the grid"
                                                Style="{StaticResource ActionButton}"
                                                Command="{Binding AddRowsCommand}"
                                                ToolTip="Keeps the rows already in the grid" />
                                        <Button Content="Replace the grid" Style="{StaticResource ActionButton}"
                                                Command="{Binding ReplaceRowsCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Throws away the rows already in the grid" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Expander>

                    <!-- The one place anything is booked. -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                            CornerRadius="5" Padding="10,8" Margin="0,10,0,0"
                            DataContext="{Binding Grid}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <!-- Saying the preview is still current, not just that one
                                     happened. Every edit to a row revokes it, so this line
                                     disappears the moment the rows stop matching the report
                                     below — which is the thing the operator needs to know
                                     before pressing a blue button. -->
                                <TextBlock VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{StaticResource Muted}"
                                           Text="Previewed — nothing written yet"
                                           Visibility="{Binding HasPreviewed, Converter={StaticResource BoolToVisible}}" />
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{StaticResource Muted}"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
                                <!-- On screen only while a run is going, which is the only
                                     time there is anything to stop. On this tab stopping
                                     also takes the rows that already went out of the grid,
                                     so pressing Book again cannot duplicate them. -->
                                <Button Content="Stop" Style="{StaticResource ActionButton}"
                                        Margin="0,0,8,0"
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"
                                        ToolTip="Stops the run. Anything already created is taken out of the grid." />
                                <Button Content="_Preview" Style="{StaticResource ActionButton}"
                                        Command="{Binding PreviewCommand}" />
                                <!-- WPF hides a tooltip on a disabled control by default, so
                                     this one was invisible exactly when it was needed: the
                                     explanation for why the button cannot be pressed yet. -->
                                <Button Content="_Book these recordings"
                                        Style="{StaticResource WriteButton}"
                                        Command="{Binding BookCommand}"
                                        ToolTipService.ShowOnDisabled="True"
                                        ToolTip="Enabled only after a preview of these exact rows" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                <TextBlock Text="Rows" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding RowCount}" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Margin="0,0,16,0" />
                                <Button Content="Remove selected" Style="{StaticResource ActionButton}"
                                        Command="{Binding RemoveSelectedCommand}" />
                                <Button Content="Clear the grid" Style="{StaticResource ActionButton}"
                                        Command="{Binding ClearCommand}" />
                                <TextBlock Text="Fallback folder" VerticalAlignment="Center"
                                           Margin="16,0,6,0" />
                                <TextBox Style="{StaticResource InlineTextBox}" Width="160"
                                         Text="{Binding DefaultFolderName, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox IsChecked="{Binding SetPresenterAsDescription}"
                                          Content="Presenter as the description" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- What would happen, or what happened. Collapsed until there is
                         something in it, so the grid gets the whole window until then. -->
                    <Expander DockPanel.Dock="Bottom" Margin="0,10,0,0" MaxHeight="180"
                              Header="What would happen / what happened"
                              IsExpanded="True"
                              DataContext="{Binding Grid}">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Outcomes.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Expander.Style>
                        <DataGrid ItemsSource="{Binding Outcomes}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0" Background="{StaticResource Surface}"
                                  BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Line}" Width="45" />
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="130" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="2*"
                                                    ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>

                    <!-- The grid. Every text column updates the source on each
                         keystroke, so a caret still sitting in a cell cannot make the
                         preview describe a stale value. -->
                    <DockPanel DataContext="{Binding Grid}">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HeaderText}"
                                   Text="Rows to book — edit any of it" />
                        <DataGrid x:Name="BookingRows" ItemsSource="{Binding Rows}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column" CanUserAddRows="False"
                                  SelectedItem="{Binding Selected, Mode=TwoWay}"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0" Background="{StaticResource Surface}"
                                  BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Line}" Width="36"
                                                    IsReadOnly="True" />
                                <DataGridTextColumn Header="Title" Width="*"
                                                    Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="Room" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- The DataContext here is the row, not the window,
                                                 so the room list has to be reached by walking up
                                                 to the window. An editable box as well as a list,
                                                 because a room the listing stopped short of is
                                                 still bookable by name. -->
                                            <ComboBox IsEditable="True"
                                                      ItemsSource="{Binding DataContext.Booking.Pattern.RoomNames,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                      Text="{Binding Room, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Date" Width="100"
                                                    Binding="{Binding Date, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Start" Width="90"
                                                    Binding="{Binding Start, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="End" Width="90"
                                                    Binding="{Binding End, UpdateSourceTrigger=PropertyChanged}" />
                                <DataGridTextColumn Header="Presenter" Width="120"
                                                    Binding="{Binding Presenter, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Folder" Width="130"
                                                    Binding="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTemplateColumn Header="Webcast" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsBroadcast, Mode=TwoWay,
                                                                  UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Notes" Width="180" IsReadOnly="True"
                                                    Binding="{Binding Notes}"
                                                    ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <!-- ============ Import a legacy schedule ============ -->
            <TabItem Header="Import a file" DataContext="{Binding Import}">
                <DockPanel Margin="4,10,4,0">

                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="_Choose file…" Style="{StaticResource ActionButton}"
                                    Command="{Binding ChooseFileCommand}" />
                            <TextBlock Text="{Binding FileSummary}" VerticalAlignment="Center"
                                       Foreground="{StaticResource Secondary}" />
                        </StackPanel>

                        <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource Muted}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"
                                   ToolTip="{Binding FilePath}" />

                        <!-- The file reader has no booking controls of its own any more:
                             the rows go into the grid on the other tab, which is where
                             the fallback folder and the preview live. Two sets of those
                             controls would be two chances for them to disagree. -->
                        <Button Content="Send these rows to the booking grid"
                                Style="{StaticResource WriteButton}"
                                HorizontalAlignment="Left" Margin="0,0,0,12"
                                Command="{Binding SendRowsCommand}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="Opens the booking grid with these rows in it" />

                        <!-- Open when there are errors, because the detail line says
                             "{n} rows could not be read" and pointed at a collapsed
                             panel. Capped in height so a file with two hundred bad
                             lines cannot push the grid off the window. -->
                        <Expander Header="Rows that could not be read" Margin="0,0,0,10"
                                  IsExpanded="{Binding HasErrors, Mode=OneWay}"
                                  Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisible}}">
                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Errors}" Margin="8,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource Danger}"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </StackPanel>

                    <!-- The diagnosis view: what the file said, unedited, which is
                         what matters when arguing with the parser about a column. -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource HeaderText}"
                                   Text="What the file said" />
                        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False"
                                  IsReadOnly="True" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0" Background="{StaticResource Surface}"
                                  BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="45" />
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Recorder" Binding="{Binding Recorder}" Width="110"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Starts" Binding="{Binding Starts}" Width="180" />
                                <DataGridTextColumn Header="Ends" Binding="{Binding Ends}" Width="80" />
                                <DataGridTextColumn Header="Presenter" Binding="{Binding Presenter}" Width="110"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="120"
                                                    ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="Notes" Binding="{Binding Warnings}" Width="180"
                                                    ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <!-- ============ Edit selected sessions ============ -->
            <TabItem Header="Edit selected sessions" DataContext="{Binding Edit}">
                <DockPanel Margin="4,10,4,0">

                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource WarningBg}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1"
                            CornerRadius="5" Padding="10,8" Margin="0,0,0,10">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningText}"
                                   Text="Tick sessions on the calendar, then preview an operation. Each preview unlocks only the operation it previewed, and nothing is written until you press the matching blue button." />
                    </Border>

                    <!-- One card per operation, each folding away when it is not the one
                         being used. This replaces four rows of fixed-width controls
                         inside a horizontal scroller: those simply fell off the right
                         edge when the window narrowed, and the scroller that was meant
                         to make them reachable contradicted itself by scrolling
                         sideways instead of wrapping. Everything here is a WrapPanel,
                         so a narrow window wraps the controls onto a second line rather
                         than hiding them.

                         The cap is deliberate. Four collapsed cards are about a hundred
                         and fifty pixels; four expanded ones are taller than any window,
                         and without a ceiling the results grid below — the thing that
                         says what happened — would be squeezed to nothing at exactly the
                         moment it matters. -->
                    <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" MaxHeight="400">
                    <StackPanel>

                        <Expander Header="Rename" IsExpanded="True" Margin="0,0,0,6">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="0,4,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="find" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox Style="{StaticResource InlineTextBox}" Width="160" Margin="0,0,16,4"
                                                 Text="{Binding Find, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="replace with" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox Style="{StaticResource InlineTextBox}" Width="160" Margin="0,0,0,4"
                                                 Text="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}" />
                                    </WrapPanel>

                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,6"
                                               Foreground="{StaticResource Muted}"
                                               Text="Matched case-sensitively, in the whole name. An empty replacement strips the text out; emptying the name entirely is refused." />

                                    <WrapPanel>
                                        <Button Content="Preview" Style="{StaticResource ActionButton}" Margin="0,0,6,0"
                                                Command="{Binding PreviewRenameCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Shows what each name would become. Nothing is written." />
                                        <Button Content="Rename" Style="{StaticResource WriteButton}"
                                                Command="{Binding ApplyRenameCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Enabled once this rename has been previewed." />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- The presenter lives in the session description, because that is
                             the only field Panopto has for one — the scheduling call has
                             none, which is why the legacy tool wrote it here. So this card
                             edits a field the app shows, and the preview prints what each
                             description would become: replacing text the operator never
                             saw is the same class of accident the delete confirmation
                             exists to prevent. -->
                        <Expander Header="Presenter (written into the description)" Margin="0,0,0,6">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="0,4,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="presenter or note" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox Style="{StaticResource InlineTextBox}" Width="300" Margin="0,0,16,4"
                                                 Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" />
                                        <CheckBox Content="add to what is there" Margin="0,0,0,4"
                                                  IsChecked="{Binding DescriptionAppend}"
                                                  ToolTip="Unticked, this replaces each description. Ticked, the text is written after whatever is already there, which is how a presenter is added to a description that already carries one." />
                                    </WrapPanel>

                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,6"
                                               Foreground="{StaticResource Muted}"
                                               Text="An empty box clears the description. The preview prints the text each recording has now, so nothing is overwritten unseen." />

                                    <WrapPanel>
                                        <Button Content="Preview" Style="{StaticResource ActionButton}" Margin="0,0,6,0"
                                                Command="{Binding PreviewDescriptionCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Shows what each description would become, including the text it has now. Nothing is written." />
                                        <Button Content="Write" Style="{StaticResource WriteButton}"
                                                Command="{Binding ApplyDescriptionCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Enabled once this description change has been previewed." />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="Move to a folder" Margin="0,0,0,6">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="0,4,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="to folder" VerticalAlignment="Center" Margin="0,0,6,4" />
                                        <TextBox Style="{StaticResource InlineTextBox}" Width="332" Margin="0,0,0,4"
                                                 Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}" />
                                    </WrapPanel>

                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,6"
                                               Foreground="{StaticResource Muted}"
                                               Text="A folder name or an id. Resolved once for the whole selection, so a name that matches nothing stops the run before anything is moved." />

                                    <WrapPanel>
                                        <Button Content="Preview" Style="{StaticResource ActionButton}" Margin="0,0,6,0"
                                                Command="{Binding PreviewMoveCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Shows where each recording would end up. Nothing is written." />
                                        <Button Content="Move" Style="{StaticResource WriteButton}"
                                                Command="{Binding ApplyMoveCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Enabled once this move has been previewed." />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Two shapes for one operation, because the two questions are
                             different: "the room was double-booked from ten, so everything
                             moves an hour later" is a shift, and "the class now starts at
                             nine" is a time of day. Both keep each recording's own length
                             AND its own date — the set time is applied to the day each
                             recording is already on, so a week of bookings stays spread
                             across the week instead of stacking onto one day. -->
                        <Expander Header="Change the times" Margin="0,0,0,6">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="0,4,0,0">
                                <StackPanel>
                                    <WrapPanel Margin="0,0,0,4">
                                        <RadioButton Content="Shift by" GroupName="RetimeMode" Margin="0,0,8,4"
                                                     IsChecked="{Binding RetimeShiftMode}"
                                                     ToolTip="Moves every recording by the same number of minutes." />
                                        <TextBox Style="{StaticResource InlineTextBox}" Width="70" Margin="0,0,8,4"
                                                 Text="{Binding RetimeShiftText, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="minutes" VerticalAlignment="Center" Margin="0,0,18,4" />
                                        <RadioButton Content="later" GroupName="RetimeDirection" Margin="0,0,10,4"
                                                     IsChecked="{Binding RetimeLater}"
                                                     ToolTip="Forward. A recording near midnight moves onto the next day, which is ordinary arithmetic rather than an error." />
                                        <RadioButton Content="earlier" GroupName="RetimeDirection" Margin="0,0,0,4"
                                                     IsChecked="{Binding RetimeEarlier}"
                                                     ToolTip="Back. A recording that would end before the room has got there is refused, and the row says so." />
                                    </WrapPanel>

                                    <WrapPanel Margin="0,0,0,6">
                                        <RadioButton Content="Set the start time to" GroupName="RetimeMode" Margin="0,0,10,4"
                                                     IsChecked="{Binding RetimeSetTimeMode}"
                                                     ToolTip="Keeps each recording's own date and length, and replaces only the time of day." />
                                        <TextBox Style="{StaticResource InlineTextBox}" Width="110" Margin="0,0,0,4"
                                                 Text="{Binding RetimeAtTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                    </WrapPanel>

                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,2,0,6"
                                               Foreground="{StaticResource Muted}"
                                               Text="A recording whose listing carries no time is reported by name rather than moved, and a shift of zero is refused — it would spend a request per session writing the times back unchanged." />

                                    <WrapPanel>
                                        <Button Content="Preview" Style="{StaticResource ActionButton}" Margin="0,0,6,0"
                                                Command="{Binding PreviewRetimeCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Shows the new slot for every recording in the selection. Nothing is written." />
                                        <Button Content="Retime" Style="{StaticResource WriteButton}"
                                                Command="{Binding ApplyRetimeCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Enabled once this retime has been previewed. One call per recording, because UpdateRecordingTime takes a single session." />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <Expander Header="Webcasting" Margin="0,0,0,6">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                               Foreground="{StaticResource Muted}"
                                               Text="Turning webcasting on for a session publishes its live stream to viewers. Preview on and Preview off are separate operations, and each unlocks only its own button." />

                                    <WrapPanel>
                                        <Button Content="Preview on" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                                Command="{Binding PreviewWebcastOnCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Shows which recordings would start webcasting. Nothing is written." />
                                        <Button Content="Turn on" Style="{StaticResource WriteButton}" Margin="0,0,16,4"
                                                Command="{Binding ApplyWebcastOnCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Enabled once 'Preview on' has been run." />
                                        <Button Content="Preview off" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                                Command="{Binding PreviewWebcastOffCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Shows which recordings would stop webcasting. Nothing is written." />
                                        <Button Content="Turn off" Style="{StaticResource WriteButton}" Margin="0,0,0,4"
                                                Command="{Binding ApplyWebcastOffCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Enabled once 'Preview off' has been run." />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Delete is the only operation here that cannot be undone, so it
                             asks for more than a press: a preview first, then the word
                             itself typed out. The confirmation appears only once the
                             preview has been seen, so it is always given against a count
                             that is on screen rather than one the operator remembers. -->
                        <Expander Margin="0,0,0,6">
                            <Expander.Header>
                                <TextBlock Text="Delete permanently" />
                            </Expander.Header>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,9" Margin="0,4,0,0">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button Content="Preview" Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                                Command="{Binding PreviewDeleteCommand}"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Shows what would be destroyed, and asks for the word. Nothing is deleted yet." />
                                        <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}"
                                                   Text="Permanently removes the ticked sessions. Panopto cannot undo it." />
                                    </WrapPanel>

                                    <Border Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource DangerSoftBorder}" BorderThickness="1"
                                            CornerRadius="5" Padding="10,8" Margin="0,8,0,0"
                                            Visibility="{Binding IsDeletePreviewed,
                                                         Converter={StaticResource BoolToVisible}}">
                                        <StackPanel>
                                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerText}"
                                                       Text="{Binding DeleteGateHint}" />

                                            <WrapPanel Margin="0,8,0,0">
                                                <TextBlock Text="{Binding DeletePrompt}"
                                                           VerticalAlignment="Center" Margin="0,0,6,4"
                                                           Foreground="{StaticResource DangerText}" />
                                                <TextBox Style="{StaticResource InlineTextBox}" Width="120" Margin="0,0,8,4"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding DeleteConfirmation,
                                                                        UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Content="Delete permanently" Margin="0,0,6,4"
                                                        Style="{StaticResource DangerButton}"
                                                        Command="{Binding ApplyDeleteCommand}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="Type the word above to enable this." />
                                                <Button Content="Cancel" Margin="0,0,0,4"
                                                        Style="{StaticResource ActionButton}"
                                                        Command="{Binding CancelDeleteCommand}"
                                                        ToolTip="Takes the word back and disarms the delete." />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- Progress and headroom, above the results rather than inside
                         them: on a term's worth of edits the wait is minutes, and a
                         wait with a number beside it is a different experience from a
                         wait without one. The rate figure comes from the limiter the
                         requests actually go through, so when it reads at the cap the
                         pause is explained rather than mysterious. -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,10,0,8">
                        <ProgressBar Width="180" Height="8" Margin="0,0,10,0"
                                     VerticalAlignment="Center"
                                     Minimum="0" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Foreground="{StaticResource Accent}"
                                     Background="{StaticResource PanelBorder}"
                                     BorderThickness="0" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,14,0"
                                   Foreground="{StaticResource Muted}"
                                   Text="{Binding ProgressText}" />
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}"
                                   Text="{Binding RateLimit}" />
                        <!-- Shown only while a run is going. Stopping here is safe to
                             repeat, unlike booking: every operation on this tab sets an
                             end state, so a second run lands on the same one. -->
                        <Button Content="Stop" Style="{StaticResource ActionButton}"
                                Margin="14,0,0,0" VerticalAlignment="Center"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"
                                ToolTip="Stops the run. Running it again is safe — every operation here sets an end state." />
                    </WrapPanel>

                    <DataGrid ItemsSource="{Binding Results}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" Background="{StaticResource Surface}"
                              BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="*"
                                                ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="120" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Message}" Width="2*"
                                                ElementStyle="{StaticResource CellText}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
